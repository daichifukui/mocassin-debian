#!/usr/bin/make -f
# -*- makefile -*-

# Uncomment this to turn on verbose mode.
#export DH_VERBOSE=1

# The sources pass buffers of different types and ranks to the same MPI
# routines through mpif.h, which gfortran >= 10 rejects by default. Newer
# mpich wrappers no longer add this flag themselves (Closes: #1149751).
export DEB_FFLAGS_MAINT_APPEND = -fallow-argument-mismatch

%:
	dh $@ --no-parallel
